bpp1
service
 name order-api
 version 2.4.1
 environment production
 debug false
 replicas 3
server
 host 0.0.0.0
 port 8080
 timeouts
  read_ms 5000
  write_ms 10000
  idle_ms 60000
 tls
  enabled true
  cert_path /etc/ssl/certs/order-api.pem
  key_path /etc/ssl/private/order-api.key
  min_version "1.2"
database
 primary
  host db-primary.internal
  port 5432
  name orders
  user order_svc
  pool
   min 5
   max 50
   idle_timeout_s 300
 replicas[2]{host port weight}
 db-replica-1.internal 5432 2
 db-replica-2.internal 5432 1
cache
 backend redis
 url redis://cache.internal:6379/0
 ttl_s 900
 key_prefix order-api:
logging
 level info
 format json
 sinks [stdout,file]
 file
  path /var/log/order-api/app.log
  rotate_mb 100
  keep 7
features
 new_checkout true
 fraud_scoring true
 gift_cards false
 beta_regions [TR,DE,NL]
rate_limits[3]{route method per_minute}
/v1/orders POST 600
/v1/orders GET 3000
/v1/orders/{id}/cancel POST 60
owners [platform-team@example.com,oncall-orders@example.com]
